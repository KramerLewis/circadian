<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates from INFOPLIST_KEY_* build settings. -->
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAlarmKitUsageDescription</key>
	<string>SunClock sets alarms for the solar events you choose, like 30 minutes before sunrise.</string>
	<!-- Background refresh that re-plans the next two weeks of alarm times. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.kray.circadian.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
</dict>
</plist>
